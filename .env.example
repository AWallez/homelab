# Configuration des collecteurs.
#
# Copier ce fichier en `.env`, le remplir, et le placer la ou les scripts le
# lisent. ⚠️ Le vrai `.env` ne doit JAMAIS entrer dans le depot : il contient
# des cles d API en clair.
#
# ⚠️ Les scripts ne citent ces variables QUE PAR LEUR NOM, jamais par leur
# valeur, et ne les affichent nulle part. C est ce qui permet de les publier
# tels quels.

# ---- adresses ------------------------------------------------------------
# L hote qui porte les services. Les collecteurs s y adressent en HTTP local.
NAS_IP=nas.local

# Le site public surveille par la sonde de disponibilite.
SITE_URL=https://example.com
SITE_HOTE=example.com

# ---- analytique ----------------------------------------------------------
# Identifiant du site dans Umami, visible dans l URL de son tableau de bord.
UMAMI_SITE_ID=00000000-0000-0000-0000-000000000000
HOMEPAGE_VAR_UMAMI_USER=
HOMEPAGE_VAR_UMAMI_PASS=

# ---- notifications -------------------------------------------------------
# ⚠️ Un jeton d ECRITURE SEULE sur un sujet dedie. Un jeton de lecture
# permettrait a n importe qui de publier de fausses alertes.
NAS_NTFY_URL=http://nas.local:8081
NAS_NTFY_TOPIC=alertes
NAS_NTFY_TOKEN=

# ---- supervision ---------------------------------------------------------
# Le nom court de la page de statut publiee par Uptime Kuma.
# ⚠️ La tuile ne voit QUE ce qui est publie sur cette page : toute nouvelle
# sonde doit y etre ajoutee, sans quoi elle n entre pas dans le pourcentage.
HOMEPAGE_VAR_KUMA_SLUG=

# ---- mediatheque ---------------------------------------------------------
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SEERR_KEY=

# ---- chaine de telechargement --------------------------------------------
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_QBIT_USER=
HOMEPAGE_VAR_QBIT_PASS=

# ---- filtrage DNS --------------------------------------------------------
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
